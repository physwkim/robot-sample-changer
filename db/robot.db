# What the daemon is doing, and the proof that it still is.
#
# `State` names the loop the daemon is in; `Alive` counts up once per
# service pass through that loop. A client needs both: `CurrentStep`
# survives the daemon's death (autosave restores it, and it is the
# resume-after-crash marker), so "the step says 12" cannot tell a live
# measurement wait from a dead one, and a control offered on that
# reading does nothing when pressed. State plus a moving Alive can.
#
# Alive means "servicing operator commands right now", not "the process
# exists": it stops advancing while the daemon works, which is exactly
# when Continue, the gripper and a jog are not being read. So that the
# quiet is never ambiguous, the daemon publishes State=1 (Run) around
# every blocking piece of work -- steps, but also the jog and the
# gripper command inside a service pass. The rule a client reads: quiet
# while Run is expected, quiet in a standing state is a dead daemon.
# Longin like Robot:Null:State -- the labels live in the GUI, next to
# step_name(). Deliberately NOT in autosave/robot_state.req: a restored
# state is the very lie this record exists to prevent.
record(longin, "Robot:State")
{
    field(DESC, "0=Idle 1=Run 2=MeasWait 3=Paused 4=Hold")
    field(VAL,  "0")
    field(HOPR, "4")
    field(LOPR, "0")
}
record(longin, "Robot:Alive")
{
    field(DESC, "Daemon heartbeat, +1 per service pass")
    field(VAL,  "0")
}

# Grip null (CalibMode=6) progress and result. The daemon owns every one
# of these; nothing else writes them. State is a plain longin rather than
# an mbbi so the labels live with the GUI, next to step_name().
record(longin, "Robot:Null:State")
{
    field(DESC, "Grip null 0=Idle 1=Run 2=Settled 3=Fail")
    field(VAL,  "0")
    field(HOPR, "3")
    field(LOPR, "0")
}
record(longin, "Robot:Null:Iter")
{
    field(DESC, "Grip null iteration in progress")
    field(VAL,  "0")
    field(HOPR, "99")
    field(LOPR, "0")
}
record(ai, "Robot:Null:DX")
{
    field(DESC, "Grip null cumulative move, tool x")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ai, "Robot:Null:DY")
{
    field(DESC, "Grip null move, tool y depth: unsteered")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ai, "Robot:Null:DZ")
{
    field(DESC, "Grip null cumulative move, tool z")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ai, "Robot:Null:Force")
{
    field(DESC, "Grip null close wrench, steered axes")
    field(VAL,  "0.0")
    field(PREC, "2")
    field(EGU,  "N")
}
record(stringin, "Robot:Null:Msg")
{
    field(DESC, "Grip null result, 39 chars")
    field(VAL,  "")
}

# What the daemon is doing, in one line: the step it is standing on, the
# wait it is holding in, or -- when a run stopped -- why it stopped. The
# log already carries the full sentence; this is the part that has to
# reach an operator who is looking at a screen and not at a terminal,
# and the question it answers is the one asked of a robot that is not
# moving: is it waiting for me, or did it give up?
#
# stringin like Robot:Null:Msg, so 39 characters: the daemon composes
# lines to fit rather than letting a long error be cut mid-word.
# Deliberately NOT in autosave/robot_state.req -- a status restored from
# disk describes a daemon that is not running, which is the lie that
# Robot:State exists to prevent.
record(stringin, "Robot:Status")
{
    field(DESC, "What the daemon is doing, 39 chars")
    field(VAL,  "no daemon")
}

# Where the pucks are, as far as the daemon knows: 0=Unknown, 1=Empty,
# 2=Occupied, one record per seat (Stage plus the ten rack holders).
#
# Two things write them and both are observations, not guesses: the
# camera seat check, which reads the seat it is about to enter, and the
# sequence itself, which knows a seat is empty once it has lifted a puck
# out of it and full once it has released one into it. A seat nothing
# has visited stays Unknown -- the arm does not tour the rack to fill
# this in, and a value invented from a taught map would be exactly the
# stale reading that makes the record worse than nothing.
#
# longin like Robot:State, and for the same reason: the labels live in
# the GUI. Deliberately NOT autosaved -- after an IOC restart nobody has
# looked, and Unknown says that where a restored Occupied would claim a
# puck that a hand may have moved in the meantime.
record(longin, "Robot:Seat:Stage")
{
    field(DESC, "Stage seat 0=Unk 1=Empty 2=Occupied")
    field(VAL,  "0")
}
record(longin, "Robot:Seat:H1")
{
    field(DESC, "Holder 1 0=Unk 1=Empty 2=Occupied")
    field(VAL,  "0")
}
record(longin, "Robot:Seat:H2")
{
    field(DESC, "Holder 2 0=Unk 1=Empty 2=Occupied")
    field(VAL,  "0")
}
record(longin, "Robot:Seat:H3")
{
    field(DESC, "Holder 3 0=Unk 1=Empty 2=Occupied")
    field(VAL,  "0")
}
record(longin, "Robot:Seat:H4")
{
    field(DESC, "Holder 4 0=Unk 1=Empty 2=Occupied")
    field(VAL,  "0")
}
record(longin, "Robot:Seat:H5")
{
    field(DESC, "Holder 5 0=Unk 1=Empty 2=Occupied")
    field(VAL,  "0")
}
record(longin, "Robot:Seat:H6")
{
    field(DESC, "Holder 6 0=Unk 1=Empty 2=Occupied")
    field(VAL,  "0")
}
record(longin, "Robot:Seat:H7")
{
    field(DESC, "Holder 7 0=Unk 1=Empty 2=Occupied")
    field(VAL,  "0")
}
record(longin, "Robot:Seat:H8")
