record(bo, "Robot:Trigger")
{
    field(DESC, "Robot trigger")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(VAL,  "0")
}
record(mbbo, "Robot:Wait")
{
    field(DESC, "Robot wait state")
    field(ZRST, "Wait")
    field(ONST, "Continue")
    field(TWST, "Abort")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(VAL,  "0")
}
record(mbbo, "Robot:CalibMode")
{
    field(DESC, "Robot Calibration Mode")
    field(ZRST, "Normal")
    field(ONST, "Holder Calib")
    field(TWST, "Sample Holder Calib")
    field(THST, "Hand-Eye Calib")
    field(FRST, "Recover")
    field(FVST, "Seat Probe")
    field(SXST, "Grip Null")
    field(SVST, "Holder Transfer")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(FRVL, "4")
    field(FVVL, "5")
    field(SXVL, "6")
    field(SVVL, "7")
    field(VAL,  "0")
}
record(longout, "Robot:StartStep")
{
    field(DESC, "Robot start step")
    field(VAL,  "0")
    field(DRVL, "0")
    field(DRVH, "300")
}
record(longout, "Robot:Holder")
{
    field(DESC, "Holder 1-10, 0=stage (grip null only)")
    field(DRVL, "0")
    field(DRVH, "100")
    field(VAL,  "1")
}
record(longout, "Robot:MapSource")
{
    field(DESC, "Null/transfer source holder")
    field(DRVL, "0")
    field(DRVH, "10")
    field(VAL,  "0")
}
record(bo, "Robot:Stop")
{
    field(DESC, "Robot pause/stop request")
    field(ZNAM, "Run")
    field(ONAM, "Pause")
    field(VAL,  "0")
}
record(longin, "Robot:CurrentStep")
{
    field(DESC, "Robot current step (1-30)")
    field(VAL,  "0")
    field(HOPR, "30")
    field(LOPR, "0")
}
record(longin, "Robot:PauseStep")
{
    field(DESC, "Robot pause at specified step")
    field(VAL,  "0")
    field(HOPR, "30")
    field(LOPR, "0")
}
record(bo, "Robot:Gripper")
{
    field(DESC, "Gripper command (set to open/close)")
    field(ZNAM, "Close")
    field(ONAM, "Open")
    field(VAL,  "0")
}
record(bi, "Robot:Gripper_RBV")
{
    field(DESC, "Gripper status readback")
    field(ZNAM, "Close")
    field(ONAM, "Open")
    field(VAL,  "0")
}
record(bi, "Robot:Loaded")
{
    field(DESC, "Sample loaded in sample holder")
    field(ZNAM, "Not Loaded")
    field(ONAM, "Loaded")
    field(VAL,  "0")
}
record(longout, "Robot:JogX")
{
    field(DESC, "Jog X direction (-1, 0, +1)")
    field(VAL,  "0")
    field(DRVL, "-1")
    field(DRVH, "1")
}
record(longout, "Robot:JogY")
{
    field(DESC, "Jog Y direction (-1, 0, +1)")
    field(VAL,  "0")
    field(DRVL, "-1")
    field(DRVH, "1")
}
record(longout, "Robot:JogZ")
{
    field(DESC, "Jog Z direction (-1, 0, +1)")
    field(VAL,  "0")
    field(DRVL, "-1")
    field(DRVH, "1")
}
record(ao, "Robot:JogStep")
{
    field(DESC, "Jog step size in mm")
    field(VAL,  "1.0")
    field(DRVL, "0.01")
    field(DRVH, "10.0")
    field(PREC, "2")
    field(EGU,  "mm")
}
record(ai, "Robot:Jog:DX")
{
    field(DESC, "Jog travel this run, tool x")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ai, "Robot:Jog:DY")
{
    field(DESC, "Jog travel this run, tool y (depth)")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ai, "Robot:Jog:DZ")
{
    field(DESC, "Jog travel this run, tool z")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(stringin, "Robot:Jog:Target")
{
    field(DESC, "Seat a jog apply would trim, empty=none")
    field(VAL,  "")
}
record(bo, "Robot:Jog:Apply")
{
    field(DESC, "Write the jog travel into the seat trims")
    field(VAL,  "0")
    field(ZNAM, "Idle")
    field(ONAM, "Apply")
}
record(longout, "Robot:Vision:Req")
{
    field(DESC, "Vision request id (sequencer writes)")
    field(VAL,  "0")
}
record(mbbo, "Robot:Vision:Kind")
{
    field(DESC, "Vision request kind")
    field(ZRST, "None")
    field(ONST, "Pick Align")
    field(TWST, "Grip Offset")
    field(THST, "Place Align")
    field(FRST, "Seating")
    field(ZRVL, "0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(THVL, "3")
    field(FRVL, "4")
    field(VAL,  "0")
}
record(longin, "Robot:Vision:Done")
{
    field(DESC, "Vision answered request id (node writes)")
    field(VAL,  "0")
}
record(bi, "Robot:Vision:Valid")
{
    field(DESC, "Vision measurement verdict")
    field(ZNAM, "Invalid")
    field(ONAM, "Valid")
    field(VAL,  "0")
}
record(ao, "Robot:Vision:DX")
{
    field(DESC, "TCP-local correction to apply, X")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ao, "Robot:Vision:DY")
{
    field(DESC, "TCP-local correction to apply, Y")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ao, "Robot:Vision:DZ")
{
    field(DESC, "TCP-local correction to apply, Z")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ao, "Robot:Vision:Quality")
{
    field(DESC, "Vision detection quality 0-1")
    field(VAL,  "0.0")
    field(PREC, "2")
}
record(bi, "Robot:Vision:Seated")
{
    field(DESC, "Puck seating verdict (Kind=Seating)")
    field(ZNAM, "Not Seated")
    field(ONAM, "Seated")
    field(VAL,  "0")
}
record(ao, "Robot:Vision:Tilt")
{
    field(DESC, "Puck top-face tilt (Kind=Seating)")
    field(VAL,  "0.0")
    field(PREC, "2")
    field(EGU,  "deg")
}

# Grip null (CalibMode=6) progress and result. The daemon owns every one
# of these; nothing else writes them. State is a plain longin rather than
# an mbbi so the labels live with the GUI, next to step_name().
record(longin, "Robot:Null:State")
{
    field(DESC, "Grip null 0=Idle 1=Run 2=Settled 3=Fail")
    field(VAL,  "0")
    field(HOPR, "3")
    field(LOPR, "0")
}
record(longin, "Robot:Null:Iter")
{
    field(DESC, "Grip null iteration in progress")
    field(VAL,  "0")
    field(HOPR, "99")
    field(LOPR, "0")
}
record(ai, "Robot:Null:DX")
{
    field(DESC, "Grip null cumulative move, tool x")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ai, "Robot:Null:DY")
{
    field(DESC, "Grip null move, tool y depth: unsteered")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ai, "Robot:Null:DZ")
{
    field(DESC, "Grip null cumulative move, tool z")
    field(VAL,  "0.0")
    field(PREC, "3")
    field(EGU,  "mm")
}
record(ai, "Robot:Null:Force")
{
    field(DESC, "Grip null close wrench, steered axes")
    field(VAL,  "0.0")
    field(PREC, "2")
    field(EGU,  "N")
}
record(stringin, "Robot:Null:Msg")
{
    field(DESC, "Grip null result, 39 chars")
    field(VAL,  "")
}
