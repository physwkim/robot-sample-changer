[Unit]
Description=MoveIt for UR3e + HandE
After=robot-ur-control.service
Wants=robot-ur-control.service

[Service]
Type=simple
WorkingDirectory=/home/stevek/ws
ExecStart=/usr/bin/bash -lc "source /opt/ros/humble/setup.bash source /opt/ros/humble/setup.bash &&source /opt/ros/humble/setup.bash && source /home/stevek/ws/install/setup.bash source /opt/ros/humble/setup.bash &&source /opt/ros/humble/setup.bash && ros2 launch ur_moveit_config ur_moveit.launch.py \\\n      ur_type:=ur3e \\\n      description_package:=ur3e_hande_robot_description \\\n      description_file:=ur_with_hande.xacro \\\n      moveit_config_package:=ur3e_hande_moveit_config \\\n      moveit_config_file:=ur.srdf \\\n      launch_rviz:=false"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=robot-stack.target
