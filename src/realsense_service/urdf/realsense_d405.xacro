<?xml version="1.0"?>
<!--
  RealSense D405 Camera URDF/XACRO

  Hand-eye 캘리브레이션 결과를 반영한 카메라 모델
  사용법:
    1. 캘리브레이션 완료 후 아래 값들을 업데이트
    2. 로봇의 URDF/XACRO에 이 파일을 include
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
  Parameters:
  - parent: 부모 링크 (보통 tool0 또는 end-effector 링크)
  - xyz: 캘리브레이션 결과의 translation (미터 단위)
  - rpy: 캘리브레이션 결과의 rotation (라디안 단위)

  캘리브레이션 결과에서 값 가져오기:
  ~/calibration_data/hand_eye_calibration_*.yaml 파일의
  camera_to_gripper_transform 값을 사용
  -->

  <xacro:macro name="realsense_d405" params="parent *origin">

    <!-- Camera Link -->
    <link name="camera_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <!-- RealSense D405 크기: 42mm x 28mm x 22mm -->
          <box size="0.042 0.028 0.022"/>
        </geometry>
        <material name="camera_silver">
          <color rgba="0.75 0.75 0.75 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.042 0.028 0.022"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.032"/>  <!-- 32g -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0"
                 iyy="0.00001" iyz="0.0"
                 izz="0.00001"/>
      </inertial>
    </link>

    <!-- Joint: parent -> camera_link -->
    <joint name="camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Camera Color Optical Frame -->
    <link name="camera_color_optical_frame"/>
    <joint name="camera_color_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_optical_frame"/>
      <!-- ROS optical frame 관례: Z forward, Y down, X right -->
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Camera Depth Optical Frame -->
    <link name="camera_depth_optical_frame"/>
    <joint name="camera_depth_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- Camera RGB Frame (D405는 color와 depth가 거의 동일 위치) -->
    <link name="camera_color_frame"/>
    <joint name="camera_color_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_color_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Camera Depth Frame -->
    <link name="camera_depth_frame"/>
    <joint name="camera_depth_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_depth_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
