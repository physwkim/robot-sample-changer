[Unit]
Description=Robot EPICS soft IOC (robot_ioc) via procServ
Documentation=file:///home/bl9b/work/robot-sample-changer/CLAUDE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/bl9b/ws/src/epics_rs_robot/robot_ioc

# robot_ioc reads these (defaulted in main.rs, set explicitly for clarity).
#
# ROBOT_DB must be this repository's db. main.rs now defaults to the db/ of
# whichever checkout the binary was built from, and this unit runs the binary
# built under ~/ws -- so the default would still land on ~/ws/db, a copy with
# no CalibMode 3-7 state labels and no Robot:MapSource record. Grip null (6)
# and holder transfer (7) would lose the PVs they steer by; the daemon reads
# an undefined mbbo value fine, but MapSource simply would not exist.
Environment=ROBOT_DB=/home/bl9b/work/robot-sample-changer/db
# ROBOT_IOC stays under the tree the binary was built from -- it is where
# autosave/robot_state.sav already lives, and moving it would start the IOC
# from an empty saved state.
Environment=ROBOT_IOC=/home/bl9b/ws/src/epics_rs_robot/robot_ioc

# procServ runs the IOC as a child and exposes its iocsh console on TCP 20001
# (localhost only by default). --foreground keeps procServ in the foreground so
# systemd (Type=simple) supervises it. procServ auto-restarts the IOC if it exits;
# systemd restarts procServ itself if procServ dies. --ignore blocks ^D/^C on the
# console from accidentally killing the IOC.
ExecStart=/usr/bin/procServ \
  --foreground --quiet \
  --name robot_ioc \
  --chdir /home/bl9b/ws/src/epics_rs_robot/robot_ioc \
  --logfile /home/bl9b/ws/src/epics_rs_robot/robot_ioc/ioc/procServ.log \
  --logstamp \
  --ignore "^D^C" \
  20001 \
  /home/bl9b/ws/src/epics_rs_robot/target/release/robot_ioc

Restart=always
RestartSec=5
TimeoutStopSec=15

# A user unit, like ur-monitor-ioc and d405-ioc on this host: no User=/Group=
# (systemd --user already runs as bl9b) and the target is the per-user
# default, not multi-user. Nothing here wants root -- TCP 20001 and CA 5064
# are unprivileged and every path is under /home/bl9b -- and dropping sudo is
# what lets the desktop launcher start it. `loginctl enable-linger bl9b` is
# what keeps it up with nobody logged in.
[Install]
WantedBy=default.target
